<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console logging -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File logging with size limits -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/chatsphere.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/chatsphere-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Keep only 3 days of logs -->
            <maxHistory>3</maxHistory>
            <!-- Max 10MB per file -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Total size cap: 50MB -->
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- App-specific logging -->
    <logger name="com.chatsphere" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>

</configuration>
